---
config:
  theme: base
  themeVariables:
    fontFamily: Arial, Helvetica, sans-serif
    fontSize: 15px
    primaryTextColor: "#1F2937"
    lineColor: "#64748B"
    clusterBkg: "#F8FAFC"
    clusterBorder: "#CBD5E1"
  flowchart:
    htmlLabels: false
    curve: linear
    nodeSpacing: 34
    rankSpacing: 42
---
%% Information-flow diagram 1: deterministic corpus and evaluation.
%% Source of truth for the rendered SVG/PDF; labels are intentionally explicit.
flowchart LR
  R["Hash-split rule table"] --> T["Deterministic CA teacher"]
  X["Initial frame"] --> T
  T --> H["8 history frames"]
  T --> Y["8 future frames"]
  H --> S["SC or exercised filter"]
  Y --> S
  S --> D["Pinned corpus<br/>and SeqAcc"]

  classDef source fill:#E8F1FB,stroke:#2563EB,stroke-width:1.4px,color:#1E3A8A
  classDef teacher fill:#ECFDF5,stroke:#059669,stroke-width:1.4px,color:#065F46
  classDef frames fill:#FFF7ED,stroke:#EA580C,stroke-width:1.4px,color:#9A3412
  classDef eval fill:#F5F3FF,stroke:#7C3AED,stroke-width:1.4px,color:#4C1D95

  class R,X source
  class T teacher
  class H,Y frames
  class S,D eval

  linkStyle 0,1 stroke:#2563EB,stroke-width:1.5px
  linkStyle 2,3 stroke:#059669,stroke-width:1.5px
  linkStyle 4,5,6 stroke:#64748B,stroke-width:1.5px